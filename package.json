{
  "name": "inventario",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy -c dist/inventario/wrangler.json",
    "tipos": "wrangler types",
    "db:migrar:local": "wrangler d1 migrations apply inventario --local",
    "db:migrar": "wrangler d1 migrations apply inventario --remote",
    "db:sembrar:local": "wrangler d1 execute inventario --local --file=./datos/datos_iniciales.sql",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.102.8",
    "hono": "^4.13.7",
    "lucide-react": "^1.44.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "zod": "^4.5.4",
    "zxing-wasm": "^3.1.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.6",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@hono/zod-validator": "^0.9.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.10.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.130.0"
  }
}
